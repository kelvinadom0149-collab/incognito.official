{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "MARKETPLACE_API_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    }
  },
  "crons": [
    { "path": "/api/cron/sla-check", "schedule": "0 * * * *" },
    { "path": "/api/cron/ghost-inventory", "schedule": "0 3 * * *" },
    { "path": "/api/cron/question-discovery", "schedule": "0 4 * * *" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
